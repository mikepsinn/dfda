# Client-side Supabase Configuration (for browser)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Google Generative AI API Key (for image analysis)
# Get yours here: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key

# Sign-in (Better Auth). Make a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Email for magic links and password resets. Locally, the Supabase stack's
# mail catcher takes SMTP on port 54325 (web view: http://127.0.0.1:54324).
SMTP_URL=smtp://127.0.0.1:54325
EMAIL_FROM="dFDA <noreply@example.com>"

# Google sign-in (optional; the button shows only when both are set)
# Get yours from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Redirect URI: <site URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# White-label branding
NEXT_PUBLIC_SITE_NAME="Open Treatment Evidence Network"
NEXT_PUBLIC_SITE_DESCRIPTION=Decentralized clinical trials and health research
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TWITTER_HANDLE=@dfda

# Optional: Log level for client-side logs (debug, info, warn, error)
NEXT_PUBLIC_LOG_LEVEL=info



