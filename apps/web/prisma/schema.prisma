model global_variable_relationships {
  id                           String                     @id @default(dbgenerated("extensions.uuid_generate_v4()"))
  predictor_global_variable_id String
  outcome_global_variable_id   String
  citation_id                  String
  condition_id                 String?
  category                     relationship_category_enum
  baseline_description         String?
  percentage_change            Float?                     @db.Real
  absolute_change_value        Float?                     @db.Real
  absolute_change_unit_id      String?
  nnh                          Float?                     @db.Real
  nnt                          Float?                     @db.Real
  is_positive_outcome          Boolean?
  confidence_interval_level    Float?
  absolute_change_ci_lower     Float?                     @db.Real
  absolute_change_ci_upper     Float?                     @db.Real
  percentage_change_ci_lower   Float?                     @db.Real
  percentage_change_ci_upper   Float?                     @db.Real
  p_value                      Float?                     @db.Real
  certainty_of_evidence        evidence_certainty_enum?
  finding_specific_notes       String?
  data_last_updated            DateTime?                  @db.Timestamptz(6)
  created_at                   DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                   @default(now()) @db.Timestamptz(6)
  units                        units?                     @relation(fields: [absolute_change_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  citations                    citations                  @relation(fields: [citation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  global_conditions            global_conditions?         @relation(fields: [condition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  outcome_variable             global_variables           @relation("global_variable_relationships_outcome_global_variable_idToglobal_variables", fields: [outcome_global_variable_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  predictor_variable           global_variables           @relation("global_variable_relationships_predictor_global_variable_idToglobal_variables", fields: [predictor_global_variable_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([predictor_global_variable_id, outcome_global_variable_id, citation_id], map: "idx_unique_gvr_finding_no_condition", where: raw("(condition_id IS NULL)"))
  @@unique([predictor_global_variable_id, outcome_global_variable_id, citation_id, condition_id], map: "idx_unique_gvr_finding_with_condition", where: raw("(condition_id IS NOT NULL)"))
  @@index([citation_id], map: "idx_gvr_citation_id")
  @@index([condition_id], map: "idx_gvr_condition_id", where: raw("(condition_id IS NOT NULL)"))
  @@index([outcome_global_variable_id], map: "idx_gvr_outcome_id")
  @@index([predictor_global_variable_id], map: "idx_gvr_predictor_id")
}

