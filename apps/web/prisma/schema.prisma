  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  form_id       String             @db.Uuid
  order         Int
  type          form_question_type
  question_text String
  description   String?
  is_required   Boolean            @default(false)
  options       Json?
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at    DateTime           @default(now()) @db.Timestamptz(6)
  form_answers  form_answers[]
  forms         forms              @relation(fields: [form_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([form_id, order])
  @@index([form_id], map: "idx_form_questions_form_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model form_submissions {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
