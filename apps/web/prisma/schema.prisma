generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes", "views"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model action_types {
  id                       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  category                 action_category
  description              String?
  requires_scheduling      Boolean?        @default(false)
  requires_results         Boolean?        @default(false)
  can_be_recurring         Boolean?        @default(false)
  default_duration_minutes Int?
  metadata                 Json?
  deleted_at               DateTime?       @db.Timestamptz(6)
  created_at               DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?       @default(now()) @db.Timestamptz(6)
  trial_actions            trial_actions[]

  @@unique([name, category])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model citations {
  id                            String                          @id @default(dbgenerated("extensions.uuid_generate_v4()"))
  type                          citation_type
  title                         String?
  authors                       String[]
  journal_or_publisher          String?
  publication_year              Int?
  volume                        String?
  issue                         String?
  pages                         String?
  doi                           String?                         @unique(map: "idx_unique_citations_doi", where: raw("(doi IS NOT NULL)"))
  pmid                          String?                         @unique(map: "idx_unique_citations_pmid", where: raw("(pmid IS NOT NULL)"))
  url                           String?
  abstract                      String?
  retrieved_at                  DateTime?                       @db.Timestamptz(6)
  aggregate_trial_count         Int?
  aggregate_participant_count   Int?
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  global_variable_relationships global_variable_relationships[]

  @@index([doi], map: "idx_citations_doi")
  @@index([pmid], map: "idx_citations_pmid")
  @@index([url], map: "idx_citations_url")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contact_messages {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  email       String
  subject     String
  message     String
  status      String    @default("new")
  assigned_to String?   @db.Uuid
  resolved_at DateTime? @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  profiles    profiles? @relation(fields: [assigned_to], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model data_submissions {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollment_id     String            @db.Uuid
  patient_id        String            @db.Uuid
  submission_date   DateTime          @db.Date
  data              Json
  status            String
  reviewed_by       String?           @db.Uuid
  review_date       DateTime?         @db.Timestamptz(6)
  review_notes      String?
  deleted_at        DateTime?         @db.Timestamptz(6)
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?         @default(now()) @db.Timestamptz(6)
  trial_enrollments trial_enrollments @relation(fields: [enrollment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patients          patients          @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles          profiles?         @relation(fields: [reviewed_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model form_answers {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id    String           @db.Uuid
  question_id      String           @db.Uuid
  answer_value     Json
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @db.Timestamptz(6)
  form_questions   form_questions   @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  form_submissions form_submissions @relation(fields: [submission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([submission_id, question_id])
  @@index([question_id], map: "idx_form_answers_question_id")
  @@index([submission_id], map: "idx_form_answers_submission_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
