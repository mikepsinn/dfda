  patients     patients       @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([form_id], map: "idx_form_submissions_form_id")
  @@index([patient_id], map: "idx_form_submissions_patient_id")
}

