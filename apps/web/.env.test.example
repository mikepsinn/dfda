# Settings for tests. Copy to .env.test. The values match the local services
# (`pnpm services:start`, see docker-compose.yml in the repository root).
# Use a separate database for tests, for example: createdb dfda_test

# Sign-in (Better Auth) and email for tests
BETTER_AUTH_SECRET=test-better-auth-secret-with-at-least-32-characters
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=test@example.com

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/dfda_test

S3_BUCKET=dfda-uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9090
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true
