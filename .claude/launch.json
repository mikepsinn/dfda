{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/web", "exec", "next", "dev", "-p", "3005"],
      "port": 3005,
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@127.0.0.1:54322/postgres",
        "BETTER_AUTH_SECRET": "test-better-auth-secret-with-at-least-32-characters",
        "SMTP_URL": "smtp://127.0.0.1:1025",
        "EMAIL_FROM": "test@example.com",
        "GOOGLE_GENERATIVE_AI_API_KEY": "test-google-generative-ai-key",
        "SUPABASE_SERVICE_ROLE_KEY": "test-service-role-key",
        "SUPABASE_JWT_SECRET": "test-jwt-secret-with-at-least-32-characters",
        "NEXT_PUBLIC_SUPABASE_URL": "http://127.0.0.1:54321",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "test-anon-key",
        "NEXT_PUBLIC_SITE_NAME": "Open Treatment Evidence Network",
        "NEXT_PUBLIC_SITE_DESCRIPTION": "Decentralized clinical trials and health research",
        "NEXT_PUBLIC_SITE_URL": "http://localhost:3005",
        "NEXT_TELEMETRY_DISABLED": "1"
      }
    },
    {
      "name": "voice-samples",
      "runtimeExecutable": "C:/Python312/python.exe",
      "runtimeArgs": ["-m", "http.server", "3010", "--bind", "127.0.0.1", "--directory", "videos/right-to-trial/voice-samples"],
      "port": 3010
    }
  ]
}
